NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=helpdesk
DATABASE_USER=helpdesk_user
DATABASE_PASSWORD=replace-me

ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
OTP_CHALLENGE_SECRET=replace-with-a-different-long-random-secret
CUSTOMER_ACCESS_TOKEN_SECRET=replace-with-a-different-long-random-secret
CUSTOMER_ACCESS_TOKEN_TTL=8h
CUSTOMER_VERIFICATION_TTL_HOURS=24
JWT_ISSUER=helpdesk-api
SESSION_FINGERPRINT_SECRET=replace-with-a-long-random-secret

EMAIL_USER=helpdesk@example.com
EMAIL_PASS=google-app-password
EMAIL_FROM=Helpdesk <helpdesk@example.com>

GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=your-google-oauth-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-web-client-secret

# Shared Gmail inbound channel. Generate the token key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/helpdesk/gmail/oauth/callback
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
GMAIL_TOKEN_KEY_VERSION=v1
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/helpdesk-gmail
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/helpdesk-gmail-push
GMAIL_PUBSUB_AUDIENCE=https://your-public-api.example.com/api/helpdesk/gmail/pubsub
GMAIL_PUBSUB_SERVICE_ACCOUNT=pubsub-push@your-project.iam.gserviceaccount.com
GMAIL_PUBSUB_VERIFICATION_TOKEN=replace-with-a-long-random-token

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Refund execution defaults to Paystack test mode. Keep live execution disabled
# until the production approval and reconciliation workflow has been exercised.
PAYSTACK_SECRET_KEY=sk_test_replace-me
PAYSTACK_MODE=test
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_MS=15000
PAYSTACK_LIVE_REFUNDS_ENABLED=false
PAYSTACK_REFUND_REQUIRED_APPROVALS=2

# Number of source-data days rebuilt by the idempotent analytics worker.
HELPDESK_ANALYTICS_LOOKBACK_DAYS=120

ENCRYPTION_KEY=replace-with-exactly-32-bytes
KEY_HOOK=utf8
LOG_CONSOLE=true
LOG_LEVEL=debug

# The main HTTP process starts Socket.io and all helpdesk workers by default.
HELPDESK_WORKERS_ENABLED=true
HELPDESK_WORKER_INTERVAL_MS=60000

# Requests allowed per 15 minutes: per address (all traffic, including
# sign-in) and per signed-in user. Defaults: 3000 and 500.
RATE_LIMIT_PER_IP=3000
RATE_LIMIT_PER_USER=500
# Behind a reverse proxy: how many proxies to trust (e.g. 1), so limits and
# logs see the visitor's address. Leave unset when the app faces users directly.
TRUST_PROXY=

# Fresh install only (npm run db:setup on an empty database): the first
# administrator. A temporary password is printed once and must be changed
# at first sign-in.
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_NAME=

# Folders the server writes. Default: resources/logs, resources/backups and
# resources/uploads in the folder the server runs from (index.js passes them).
LOG_PATH=
BACKUP_PATH=
UPLOAD_PATH=

# The project's own migrations folder (its tables and rows), applied after
# the framework's. Leave unset when the project has none.
MIGRATIONS_PATH=
