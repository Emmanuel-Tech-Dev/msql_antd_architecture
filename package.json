{
  "name": "msql-antd-framework",
  "private": true,
  "workspaces": [
    "packages/framework-ui",
    "packages/framework-server",
    "ui",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:ui": "npm run dev -w ui",
    "dev:api": "npm run dev -w server",
    "build": "npm run build -w @msql-antd/framework-ui && npm run build -w ui",
    "test": "npm test -w @msql-antd/framework-ui -w @msql-antd/framework-server",
    "lint": "npm run lint -w @msql-antd/framework-ui -w ui",
    "migrate": "npm run migrate -w server",
    "db:setup": "npm run db:setup -w server"
  }
}
