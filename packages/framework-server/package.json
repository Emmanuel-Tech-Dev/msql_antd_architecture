{
  "name": "@msql-antd/framework-server",
  "version": "0.1.0",
  "description": "Express and MySQL server for the msql-antd framework: auth, ACL and ABAC, generic CRUD, metadata, migrations, backups and logs.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "msql-antd-migrate": "scripts/run-migration.js",
    "msql-antd-db-setup": "scripts/db-setup.js"
  },
  "files": [
    "index.js",
    "createServer.js",
    "core",
    "route",
    "shared",
    "schema",
    "resources/migrations",
    "resources/schema",
    "resources/seeds",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "license": "ISC",
  "scripts": {
    "test": "jest --runInBand",
    "test:acl": "jest tests/authorizationPolicy.test.js --runInBand",
    "db:snapshot": "node scripts/db-snapshot.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.2.0",
    "@logtail/node": "^0.5.8",
    "@logtail/winston": "^0.5.8",
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "flatted": "^3.3.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "lru-cache": "^11.1.0",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "nanoid": "^3.3.11",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.0.5",
    "otp": "^1.1.2",
    "qrcode": "^1.5.4",
    "request-ip": "^3.3.0",
    "response-time": "^2.3.4",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msql-antd/msql_antd_architecture.git",
    "directory": "packages/framework-server"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
